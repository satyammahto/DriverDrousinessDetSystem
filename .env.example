# Serial and Hardware Configuration
# Update SERIAL_PORT with the port assigned to your ESP32 (e.g. COM3, COM8, /dev/ttyUSB0)
SERIAL_PORT=COM8
BAUD_RATE=115200

# Camera Configuration
# Camera device index (typically 0 for default USB camera)
CAMERA_INDEX=0

# Detection & Buzzer Thresholds (in seconds)
CLOSED_TIME_THRESHOLD=2.0
BUZZER_DURATION=5.0

# Web Cockpit Dashboard
DASHBOARD_PORT=8000
